[Unit]
Description=Camp Race (Next.js)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/var/www/camp-race
Environment=NODE_ENV=production
Environment=PORT=3000
# Секреты хранятся только на сервере, не в репозитории
EnvironmentFile=/etc/camp-race.env
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=5
# Increase if needed
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
